# ══════════════════════════════════════════
# SoundWave Backend — Environment Variables
# ══════════════════════════════════════════
# Copy file ini jadi .env, lalu isi nilainya.
# JANGAN commit file .env ke git!

# Port backend
PORT=3000

# Midtrans Sandbox
# Ambil dari: https://dashboard.sandbox.midtrans.com/settings/config_info
# Ganti xxxxxxxx dengan kunci milikmu sendiri.
MIDTRANS_SERVER_KEY=xxxxxxxx
MIDTRANS_CLIENT_KEY=xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Firebase Admin SDK
# Download service account key JSON dari:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Simpan file JSON-nya di folder ini, lalu tulis nama filenya di bawah:
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Alternatif kalau backend jalan di platform tanpa penyimpanan berkas:
# tempel seluruh isi service account sebagai satu baris JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opsional. Kalau kosong, project id diambil dari service account.
FIREBASE_PROJECT_ID=

# Hanya untuk skrip uji. Web API key Firebase, dipakai menukar custom token
# jadi ID token saat menguji rute admin. Tidak dipakai server.js.
FIREBASE_WEB_API_KEY=

# Jendela reservasi dalam menit.
# Harus sama dengan AppConstants.reservationHoldMinutes di aplikasi Flutter.
# Kunci penanda tangan QR tiket (Ed25519).
# Buat pasangan baru dengan: node buat_kunci_qr.js
# Kunci publiknya harus sama dengan publicKeyRing di aplikasi Flutter.
ED25519_KEY_ID=v3
ED25519_PRIVATE_KEY_HEX=

RESERVATION_HOLD_MINUTES=5

# Alamat publik backend (tunnel). Dipakai untuk callback dan tautan invoice.
BASE_URL=
GOPAY_CALLBACK_URL=

# 1 = log verbose, 0 = ringkas
LOG_VERBOSE=0
