# ══════════════════════════════════════════
# SoundWave Backend — Environment Variables
# ══════════════════════════════════════════
# Copy file ini jadi .env, lalu isi nilainya.
# JANGAN commit file .env ke git!

# Port backend
PORT=3000

# Midtrans Sandbox Keys
# Ambil dari: https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=xxxxxxxx
MIDTRANS_CLIENT_KEY=xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Firebase Admin SDK
# Download service account key JSON dari:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Simpan file JSON-nya di folder ini, lalu tulis nama filenya di bawah:
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
